rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /recipe-images/{recipeId}/{fileName} {
      // Recipe photos are used by the public catalog through Firebase download URLs.
      allow read: if true;
      // Only signed-in admin users can upload valid, reasonably sized image files.
      allow create, update: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null;
    }
  }
}
