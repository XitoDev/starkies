{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npx ng build catalog --configuration production",
  "outputDirectory": "dist/catalog/browser",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/p/:code",
      "destination": "/api/order-short?code=:code"
    },
    {
      "source": "/galletas/:slug/:id",
      "destination": "/api/cookie-page?slug=:slug&id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
