{
  "name": "starkies",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:dev": "npx vercel dev --listen 3000",
    "firestore:migrate:root": "node scripts/migrate-firestore-root.mjs",
    "firestore:migrate:root:apply": "node scripts/migrate-firestore-root.mjs --apply",
    "firestore:migrate:root:verify": "node scripts/migrate-firestore-root.mjs --verify",
    "firestore:catalog:projection": "node scripts/sync-public-catalog.mjs",
    "firestore:catalog:projection:apply": "node scripts/sync-public-catalog.mjs --apply",
    "firestore:catalog:projection:verify": "node scripts/sync-public-catalog.mjs --verify",
    "firestore:cleanup:legacy": "node scripts/cleanup-legacy-firestore.mjs",
    "firestore:cleanup:legacy:apply": "node scripts/cleanup-legacy-firestore.mjs --apply --confirm-delete-legacy-collections"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3",
    "firebase": "^12.0.0",
    "@lucide/angular": "1.59.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/ssr": "^22.2.3",
    "firebase-admin": "^13.4.0",
    "@angular/cdk": "^22.2.0",
    "@angular/material": "^22.2.0",
    "simple-icons": "16.35.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "@types/node": "^22.13.10"
  },
  "type": "module"
}
