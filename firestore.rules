rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isApprovedAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    match /adminUsers/{userId} {
      allow read: if isApprovedAdmin() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Only deliberately published storefront documents are public.
    match /publicCatalog/{document=**} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    // Rate limits remain server-only. Phone lookup indexes are private to approved
    // admins because the Admin UI validates and maintains them during customer/order edits.
    match /publicOrderRateLimits/{document=**} {
      allow read, write: if false;
    }
    match /customerPhoneLookup/{document=**} {
      allow read, write: if isApprovedAdmin();
    }
    match /orderPhoneLookup/{document=**} {
      allow read, write: if isApprovedAdmin();
    }
    match /promotions/{document=**} {
      allow read, write: if isApprovedAdmin();
    }
    // Per-customer promotion redemptions contain hashed customer identifiers and stay server-only.
    match /promotionRedemptions/{document=**} {
      allow read, write: if false;
    }

    // All other root collections are restricted to explicitly approved admins.
    match /{collectionName}/{document=**} {
      allow read, write: if collectionName != 'adminUsers'
        && collectionName != 'publicCatalog'
        && collectionName != 'publicOrderRateLimits'
        && collectionName != 'customerPhoneLookup'
        && collectionName != 'orderPhoneLookup'
        && collectionName != 'promotions'
        && collectionName != 'promotionRedemptions'
        && isApprovedAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
