{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npx ng build admin --configuration production",
  "outputDirectory": "dist/admin/browser",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/api/admin-order-document",
      "destination": "/api/order-document?mode=admin"
    }
  ]
}
